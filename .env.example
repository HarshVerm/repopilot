# Application
APP_ENV=development
TASK_LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
# Required in production when frontend/API use sibling hosts, e.g. .example.com
COOKIE_DOMAIN=
# Development compatibility only. Production forces this off.
ALLOW_LEGACY_UNAUTHENTICATED_API=true

# GitHub OAuth identity and GitHub App repository access
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Local alternative to embedding the PEM contents:
# GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/github-app.private-key.pem
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Encrypts stored GitHub user and refresh tokens. Required in production.
# Generate independently from SESSION_SECRET and keep it stable.
GITHUB_USER_TOKEN_ENCRYPTION_SECRET=replace-with-an-independent-32-character-secret

# Providers and persistence
OPENAI_API_KEY=
DATABASE_URL=postgresql+asyncpg://repopilot:repopilot@localhost:5432/repopilot
